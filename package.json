{
  "name": "carnival-christmas",
  "private": true,
  "version": "0.1.0",
  "description": "A shared North Pole map where every workshop participant owns one booth and grows it through a software factory.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint --pass-on-unpruned-suppressions . && markdownlint-cli2 && node scripts/check-json.ts && knip",
    "typecheck": "tsc --noEmit && node scripts/strict-types.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "playwright test",
    "lint:shell": "shellcheck setup.sh && actionlint",
    "test:changed": "node scripts/diff-coverage.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "knip": "^6.48.0",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
