{
  "name": "carnival-christmas-public/carnival-christmas-public",
  "dependencies": {},
  "actions": {
    "follow-ticket-changes": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-haiku-4-5",
      "skill": "tessl/factory#follow-ticket-changes"
    },
    "implement": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/factory#implement-github-issue",
      "concurrency": {
        "keys": [
          {
            "key": "implement:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      },
      "instructions": "The factory's sandbox can't start a browser: never run npm run smoke or install Playwright here, even if the issue lists it. CI runs the smoke test on the pull request. Run npm run format, npm run check and npm run build instead."
    },
    "implement-booth": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-sonnet-5-5",
      "skill": "tessl/factory#implement-github-issue",
      "concurrency": {
        "keys": [
          {
            "key": "implement:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      },
      "instructions": "This is a booth request: the change lives only in booths/<the issue author's login, in lower case>/. Everything you need is in AGENTS.md (the booth section), docs/style.md and northpole/square.ts, northpole/theme.ts and northpole/diorama.ts; don't explore further. For a new booth, write a compact first version (aim for 300 lines or fewer in booth.ts) in a few edits rather than one huge file, then improve it if time allows. Change nothing outside the booth's folder, and keep checks to that folder: npx eslint booths/<login>, npx tsc --noEmit, and npx vitest run booths/<login> northpole/booths.test.ts scripts/square-code.test.ts scripts/square-size.test.ts. The factory's sandbox can't start a browser: never run npm run smoke or install Playwright here, even if the issue lists it. CI runs the smoke test on the pull request."
    },
    "merge-conflict-sweep": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-sonnet-5-5",
      "skill": "tessl/factory#merge-conflict-sweep",
      "timeout": "2h",
      "environment": "northpole-carnival-factory-merge-conflict-sweep",
      "inputs": {
        "FIXER_ACTION": "shepherd",
        "GITHUB_AUTHOR_IDS": "{{ github.tesslApp.userId }}",
        "GITHUB_ISSUE_LABEL": "tessl"
      }
    },
    "shepherd": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl/factory#shepherd",
      "concurrency": {
        "keys": [
          {
            "key": "github:pr:{{ inputs.GITHUB_REPOSITORY }}:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ],
        "debounce": "90s"
      }
    },
    "assess-booth-request": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "file:plugins/north-pole#assess-booth-request",
      "concurrency": {
        "keys": [
          {
            "key": "assess-booth-request:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "assess-badge-request": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-sonnet-5-5",
      "skill": "file:plugins/north-pole#assess-badge-request",
      "concurrency": {
        "keys": [
          {
            "key": "assess-badge-request:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "assess-booth-risk": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "file:plugins/north-pole#assess-booth-risk",
      "concurrency": {
        "keys": [
          {
            "key": "assess-booth-risk:github-pr:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ],
        "debounce": "2m"
      }
    }
  },
  "triggers": {
    "follow-ticket-changes-issue-unlabelled": {
      "on": [
        "github:issues.unlabeled"
      ],
      "when": {
        "event.label.name": "tessl",
        "event.sender.type": {
          "not": {
            "equals": "Bot"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "taken-back",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-issue-closed": {
      "on": [
        "github:issues.closed"
      ],
      "when": {
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "issue-ended",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-issue-replied": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "false",
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.sender.id": {
          "in": [
            70908
          ]
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "replied",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-pr-closed": {
      "on": [
        "github:pull_request.closed"
      ],
      "when": {
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "pr-closed",
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}",
          "GITHUB_ISSUE_LABEL": "tessl"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-pr:{{ event.repository.full_name }}:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "implement": {
      "on": [
        "github:issues.labeled"
      ],
      "when": {
        "event.label.name": "tessl",
        "event.sender.id": {
          "in": [
            70908
          ]
        },
        "event.issue.labels.*.name": {
          "none": {
            "equals": "booth-request"
          }
        }
      },
      "action": {
        "use": "implement",
        "inputs": {
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "implement-booth-by-maintainer": {
      "on": [
        "github:issues.labeled"
      ],
      "when": {
        "event.label.name": "tessl",
        "event.sender.id": {
          "in": [
            70908
          ]
        },
        "event.issue.labels.*.name": {
          "any": {
            "equals": "booth-request"
          }
        }
      },
      "action": {
        "use": "implement-booth",
        "inputs": {
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "implement-after-assessment": {
      "on": [
        "github:issues.labeled"
      ],
      "when": {
        "event.label.name": "tessl",
        "event.sender.id": "{{ github.tesslApp.userId }}"
      },
      "action": {
        "use": "implement-booth",
        "inputs": {
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "merge-conflict-sweep": {
      "on": [
        "github:push"
      ],
      "when": {
        "isDefaultBranch": "true"
      },
      "action": "merge-conflict-sweep",
      "concurrency": {
        "keys": [
          {
            "key": "merge-conflict-sweep:{{ event.repository.id }}",
            "limit": 1
          }
        ],
        "debounce": "5m"
      }
    },
    "shepherd-pr-review": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            70908
          ]
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.repo.id": 1469850421
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}",
          "GITHUB_REPOSITORY": "{{ event.repository.full_name }}"
        }
      }
    },
    "shepherd-pr-review-tessl-reviewer": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.sender.id": "{{ github.tesslReviewerApp.userId }}",
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.repo.id": 1469850421
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}",
          "GITHUB_REPOSITORY": "{{ event.repository.full_name }}"
        }
      }
    },
    "shepherd-pr-review-comment": {
      "on": [
        "github:pull_request_review_comment.created"
      ],
      "when": {
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.sender.id": {
          "in": [
            70908
          ]
        },
        "event.pull_request.head.repo.id": 1469850421
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}",
          "GITHUB_REPOSITORY": "{{ event.repository.full_name }}"
        }
      }
    },
    "shepherd-pr-comment": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "true",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.sender.id": {
          "in": [
            70908
          ]
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.issue.number }}",
          "GITHUB_REPOSITORY": "{{ event.repository.full_name }}"
        }
      }
    },
    "shepherd-pr-checks-failed": {
      "on": [
        "github:check_run.completed"
      ],
      "when": {
        "event.check_run.conclusion": {
          "in": [
            "failure",
            "timed_out",
            "startup_failure",
            "action_required"
          ]
        },
        "event.check_run.pull_requests.0.number": {
          "exists": true
        },
        "event.check_run.check_suite.head_branch": {
          "matches": "^tessl/"
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.check_run.pull_requests.0.number }}",
          "GITHUB_REPOSITORY": "{{ event.repository.full_name }}"
        }
      }
    },
    "shepherd-pr-checks-passed": {
      "on": [
        "github:check_suite.completed"
      ],
      "when": {
        "event.check_suite.conclusion": "success",
        "event.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_suite.pull_requests.0.number": {
          "exists": true
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.check_suite.pull_requests.0.number }}",
          "GITHUB_REPOSITORY": "{{ event.repository.full_name }}"
        }
      }
    },
    "assess-booth-request-opened": {
      "on": [
        "github:issues.opened"
      ],
      "when": {
        "event.issue.labels.*.name": {
          "any": {
            "equals": "booth-request"
          }
        },
        "event.sender.type": "User"
      },
      "action": {
        "use": "assess-booth-request",
        "inputs": {
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "assess-badge-request-opened": {
      "on": [
        "github:issues.opened"
      ],
      "when": {
        "event.issue.labels.*.name": {
          "any": {
            "equals": "badge-request"
          }
        },
        "event.sender.type": "User"
      },
      "action": {
        "use": "assess-badge-request",
        "inputs": {
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "assess-booth-request-edited": {
      "on": [
        "github:issues.edited"
      ],
      "when": {
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "needs-info"
          }
        },
        "event.sender.type": "User"
      },
      "action": {
        "use": "assess-booth-request",
        "inputs": {
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "assess-booth-risk-checks-passed": {
      "on": [
        "github:check_suite.completed"
      ],
      "when": {
        "event.check_suite.conclusion": "success",
        "event.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_suite.pull_requests.0.number": {
          "exists": true
        },
        "event.check_suite.app.slug": "github-actions"
      },
      "action": {
        "use": "assess-booth-risk",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.check_suite.pull_requests.0.number }}"
        }
      }
    },
    "assess-booth-risk-look-again": {
      "on": [
        "github:pull_request.unlabeled"
      ],
      "when": {
        "event.label.name": "needs-human",
        "event.sender.id": {
          "in": [
            70908
          ]
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1469850421
      },
      "action": {
        "use": "assess-booth-risk",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}"
        }
      }
    },
    "assess-booth-request-replied": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "false",
        "event.issue.state": "open",
        "event.sender.type": "User",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "needs-info"
          }
        }
      },
      "action": {
        "use": "assess-booth-request",
        "inputs": {
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      }
    }
  },
  "environment": "northpole-carnival-factory-env"
}
